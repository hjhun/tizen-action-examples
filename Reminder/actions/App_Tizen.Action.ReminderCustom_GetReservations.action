{
  "version": "v2",
  "name": "App_Tizen.Action.ReminderCustom_GetReservations",
  "type": "tidl",
  "category": "Tizen.Action.ReminderCustom",
  "description": "GetReservations for app-owned Common Emulator reservation simulator. Does not operate a TV tuner or recording backend.",
  "allowedBackground": "true",
  "autoDispose": "false",
  "requiredPrivileges": [],
  "inputSchema": {
    "type": "object",
    "properties": {}
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "return": {
        "type": "Tizen.Entity.Status",
        "description": "Success or bounded invalid/missing/internal status."
      },
      "result": {
        "type": "array",
        "description": "Current app-owned entities in deterministic order.",
        "items": {
          "type": "Tizen.Entity.Reservation"
        }
      }
    }
  },
  "details": {
    "appid": "org.tizen.actionexamples.reminder"
  }
}
