// Calendar native Edje theme. Generated .edj is built from this source.

#define CALENDAR_BUTTON(STYLE, R, G, B, PR, PG, PB, TR, TG, TB, SIZE, AX, AY) \
group { name: "calendar/button/"STYLE; \
  min: 40 40; \
  parts { \
    part { name: "focus"; type: RECT; mouse_events: 0; \
      description { state: "default" 0.0; color: 0 0 0 0; } \
      description { state: "focused" 0.0; color: 28 29 34 255; } \
    } \
    part { name: "base"; type: RECT; mouse_events: 0; \
      description { state: "default" 0.0; color: R G B 255; \
        rel1.offset: 2 2; rel2.offset: -3 -3; } \
      description { state: "pressed" 0.0; color: PR PG PB 255; \
        rel1.offset: 3 3; rel2.offset: -4 -4; } \
      description { state: "focused" 0.0; color: R G B 255; \
        rel1.offset: 5 5; rel2.offset: -6 -6; } \
    } \
    part { name: "calendar.text"; type: TEXT; mouse_events: 0; scale: 1; \
      description { state: "default" 0.0; color: TR TG TB 255; \
        rel1.offset: 10 4; rel2.offset: -11 -5; \
        text { font: "Sans"; size: SIZE; align: AX AY; \
          min: 0 0; ellipsis: 0.0; text_class: "calendar_button"; } \
      } \
    } \
    part { name: "event"; type: RECT; repeat_events: 1; \
      description { state: "default" 0.0; color: 0 0 0 0; } \
    } \
  } \
  programs { \
    program { signal: "mouse,down,1"; source: "event"; \
      action: STATE_SET "pressed" 0.0; target: "base"; } \
    program { signal: "mouse,up,1"; source: "event"; \
      action: STATE_SET "default" 0.0; target: "base"; } \
    program { signal: "calendar,state,focused"; source: "calendar"; \
      action: STATE_SET "focused" 0.0; target: "focus"; target: "base"; } \
    program { signal: "calendar,state,unfocused"; source: "calendar"; \
      action: STATE_SET "default" 0.0; target: "focus"; target: "base"; } \
  } \
}

#define CALENDAR_CELL(STYLE, R, G, B, TR, TG, TB, BORDER) \
group { name: "calendar/button/"STYLE; \
  min: 40 40; \
  parts { \
    part { name: "focus"; type: RECT; mouse_events: 0; \
      description { state: "default" 0.0; color: 28 29 34 BORDER; } \
      description { state: "focused" 0.0; color: 28 29 34 255; } \
    } \
    part { name: "base"; type: RECT; mouse_events: 0; \
      description { state: "default" 0.0; color: R G B 255; \
        rel1.offset: 4 4; rel2.offset: -5 -5; } \
      description { state: "focused" 0.0; inherit: "default" 0.0; \
        rel1.offset: 8 8; rel2.offset: -9 -9; } \
    } \
    part { name: "calendar.day"; type: TEXT; mouse_events: 0; scale: 1; \
      description { state: "default" 0.0; color: TR TG TB 255; \
        rel1.relative: 0.0 0.0; rel1.offset: 14 10; \
        rel2.relative: 1.0 0.38; rel2.offset: -15 -1; \
        text { font: "Sans"; size: 16; align: 0.0 0.0; \
          min: 0 0; ellipsis: 0.0; } \
      } \
    } \
    part { name: "chip"; type: RECT; mouse_events: 0; \
      description { state: "default" 0.0; color: 0 0 0 0; visible: 0; \
        rel1.relative: 0.0 0.38; rel1.offset: 10 0; \
        rel2.relative: 1.0 0.68; rel2.offset: -11 -1; } \
      description { state: "visible" 0.0; inherit: "default" 0.0; \
        color: 255 209 151 255; visible: 1; } \
    } \
    part { name: "calendar.event"; type: TEXT; mouse_events: 0; scale: 1; \
      description { state: "default" 0.0; color: 42 43 48 0; visible: 0; \
        rel1.to: "chip"; rel2.to: "chip"; \
        rel1.offset: 8 2; rel2.offset: -9 -3; \
        text { font: "Sans"; size: 10; align: 0.0 0.5; \
          min: 0 0; ellipsis: 0.0; } \
      } \
      description { state: "visible" 0.0; inherit: "default" 0.0; \
        color: 42 43 48 255; visible: 1; } \
    } \
    part { name: "event"; type: RECT; repeat_events: 1; \
      description { state: "default" 0.0; color: 0 0 0 0; } \
    } \
  } \
  programs { \
    program { signal: "calendar,state,focused"; source: "calendar"; \
      action: STATE_SET "focused" 0.0; target: "focus"; target: "base"; } \
    program { signal: "calendar,state,unfocused"; source: "calendar"; \
      action: STATE_SET "default" 0.0; target: "focus"; target: "base"; } \
    program { signal: "calendar,state,event,visible"; source: "calendar"; \
      action: STATE_SET "visible" 0.0; target: "chip"; \
      target: "calendar.event"; } \
  } \
}

collections {
  CALENDAR_BUTTON("calendar_command", 247,248,251, 232,234,239,
                  42,43,48, 12, 0.5, 0.5)
  CALENDAR_BUTTON("calendar_selected", 225,234,250, 210,222,243,
                  42,43,48, 12, 0.5, 0.5)
  CALENDAR_CELL("calendar_cell", 242,244,247, 42,43,48, 0)
  CALENDAR_CELL("calendar_cell_muted", 249,250,251, 190,194,202, 0)
  CALENDAR_CELL("calendar_cell_selected", 225,234,250, 42,43,48, 255)
  CALENDAR_BUTTON("calendar_event", 255,209,151, 246,190,120,
                  42,43,48, 15, 0.0, 0.5)
  CALENDAR_BUTTON("calendar_action", 250,250,251, 236,238,242,
                  42,43,48, 12, 0.5, 0.5)
  CALENDAR_BUTTON("calendar_accent", 255,96,0, 226,78,0,
                  255,255,255, 12, 0.5, 0.5)
  CALENDAR_BUTTON("calendar_toggle", 178,66,0, 148,54,0,
                  255,255,255, 12, 0.5, 0.5)
  CALENDAR_BUTTON("calendar_danger", 198,43,38, 163,30,27,
                  255,255,255, 12, 0.5, 0.5)
}
